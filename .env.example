# For a viewer on this computer, localhost is sufficient.
# For viewers on your LAN, use this server computer's LAN IP here.
CAST_HOST=127.0.0.1
# The Android app always connects to TCP 49152; keep this port for normal LAN use.
TCP_BIND=0.0.0.0:49152
# Set to 0.0.0.0:8080 only when you want other trusted LAN devices to view.
WEB_BIND=127.0.0.1:8080
RTC_BIND=0.0.0.0:8189
